<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24">
  <!-- Background -->
  <rect width="24" height="24" fill="none"/>

  <!-- Main document shape with purple color -->
  <path d="M 3 5 L 3 19 L 21 19 L 21 5 L 3 5 z" fill="#8B5CF6" opacity="0.9"/>

  <!-- 'M' for Markdown -->
  <path d="M 6 9 L 6 15 L 8 15 L 8 11.5 L 9.5 13 L 11 11.5 L 11 15 L 13 15 L 13 9 L 10.5 9 L 9.5 10 L 8.5 9 L 6 9 z" fill="#ffffff"/>

  <!-- Code indicator (green dot) -->
